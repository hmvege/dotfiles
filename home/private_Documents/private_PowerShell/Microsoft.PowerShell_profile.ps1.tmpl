# ============================================================================
# Profile startup timing
#
# Enable before starting PowerShell with:
#   $env:PS_PROFILE_TIMING = "1"
# ============================================================================

$profileTiming = $env:PS_PROFILE_TIMING -eq "1"

if ($profileTiming) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $totalSw = [System.Diagnostics.Stopwatch]::StartNew()
}

function Write-Timing {
    param(
        [Parameter(Mandatory)]
        [string]$Label
    )

    if (-not $profileTiming) {
        return
    }

    $sw.Stop()
    "{0}: {1} ms" -f $Label, $sw.ElapsedMilliseconds
    $sw.Restart()
}


# ============================================================================
# Git
# ============================================================================

# Load the broader alias set first so our preferred shortcuts take precedence.
if (Get-Module -ListAvailable git-aliases) {
    Import-Module git-aliases
}

# Short git checkout command.
#
# posh-git provides Git completion for the underlying Git command.
function Git-Checkout {
    git checkout @args
}

function Git-Commit {
    git commit @args
}

function Git-CommitMessage {
    git commit --message @args
}

function Git-CommitAllMessage {
    git commit --all --message @args
}

# Override gc (normally Get-Content) and any module-provided shortcuts.
Set-Alias -Name gco -Value Git-Checkout -Option AllScope -Force
Set-Alias -Name gc -Value Git-Commit -Option AllScope -Force
Set-Alias -Name gcmsg -Value Git-CommitMessage -Option AllScope -Force
Set-Alias -Name gcam -Value Git-CommitAllMessage -Option AllScope -Force

Write-Timing "Git aliases"


# ============================================================================
# PSReadLine
# ============================================================================

if (Get-Module -ListAvailable PSReadLine) {
    Import-Module PSReadLine

    Write-Timing "PSReadLine import"

    Set-PSReadLineOption `
        -EditMode Vi `
        -PredictionSource History `
        -MaximumHistoryCount 20000 `
        -HistorySearchCursorMovesToEnd

    Write-Timing "PSReadLine options"

    # Completion/history behavior.
    Set-PSReadLineKeyHandler `
        -Chord Tab `
        -Function MenuComplete

    Set-PSReadLineKeyHandler `
        -Chord UpArrow `
        -Function HistorySearchBackward `
        -ViMode Insert

    Set-PSReadLineKeyHandler `
        -Chord DownArrow `
        -Function HistorySearchForward `
        -ViMode Insert

    Set-PSReadLineKeyHandler `
        -Chord Alt+d `
        -Function KillWord `
        -ViMode Insert

    Set-PSReadLineKeyHandler `
        -Chord Ctrl+w `
        -Function BackwardDeleteWord `
        -ViMode Insert

    Write-Timing "PSReadLine keybindings"
}


# ============================================================================
# PSFzf
# ============================================================================

$hasPsFzf = $null -ne (
    Get-Command Set-PsFzfOption -ErrorAction SilentlyContinue
)

Write-Timing "PSFzf detection"

if ($hasPsFzf) {
    Set-PsFzfOption `
        -PSReadlineChordProvider 'Ctrl+t' `
        -PSReadlineChordReverseHistory 'Ctrl+r'
}

Write-Timing "PSFzf setup"


# ============================================================================
# posh-git
# ============================================================================

$hasPoshGit = $null -ne (
    Get-Module -ListAvailable posh-git
)

Write-Timing "posh-git detection"

if ($hasPoshGit) {
    $env:POSH_GIT_ENABLED = $true
    Import-Module posh-git

    Write-Timing "posh-git import"
}


# ============================================================================
# Oh My Posh
# ============================================================================

$hasOhMyPosh = $null -ne (
    Get-Command oh-my-posh -ErrorAction SilentlyContinue
)

Write-Timing "oh-my-posh detection"

if ($hasOhMyPosh) {
    $ompConfig = $null

    if ($env:POSH_THEMES_PATH) {
        $ompConfig = Join-Path `
            $env:POSH_THEMES_PATH `
            "wopian.omp.json"
    }

    $previousOutputEncoding = [Console]::OutputEncoding
    [Console]::OutputEncoding = [Text.Encoding]::UTF8

    try {
        if ($ompConfig -and (Test-Path -LiteralPath $ompConfig)) {
            oh-my-posh init pwsh --config $ompConfig |
                Invoke-Expression
        }
        else {
            oh-my-posh init pwsh |
                Invoke-Expression
        }
    }
    finally {
        [Console]::OutputEncoding = $previousOutputEncoding
    }

    Write-Timing "oh-my-posh init"
}


# ============================================================================
# zoxide
# ============================================================================

$hasZoxide = $null -ne (
    Get-Command zoxide -ErrorAction SilentlyContinue
)

Write-Timing "zoxide detection"

if ($hasZoxide) {
    zoxide init powershell |
        Out-String |
        Invoke-Expression

    Write-Timing "zoxide init"
}


# ============================================================================
# Startup timing
# ============================================================================

if ($profileTiming) {
    $totalSw.Stop()
    "Total profile load: $($totalSw.ElapsedMilliseconds) ms"
}