{{ if and .gui (not .lite) -}}
{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.osRelease.id "ubuntu" -}}

package_dir=${HOME}/.config/sublime-text-3/Packages
installed_packages_dir=${HOME}/.config/sublime-text-3/Installed\ Packages/
mkdir -pv "$package_dir" "$installed_packages_dir"

# Scope the repository key instead of adding it to apt's global trust store.
sudo install -d -m 0755 /etc/apt/keyrings
key_file="$(mktemp)"
package_file=""
trap 'rm -f "$key_file" "${package_file:-}"' EXIT
curl -fsSL https://download.sublimetext.com/sublimehq-pub.gpg -o "$key_file"
sudo install -m 0644 "$key_file" /etc/apt/keyrings/sublimehq-pub.asc
# Replace the list file used by previous versions of these dotfiles.
echo "deb [signed-by=/etc/apt/keyrings/sublimehq-pub.asc] https://download.sublimetext.com/ apt/stable/" | sudo tee /etc/apt/sources.list.d/sublime-text.list > /dev/null

sudo apt-get update
sudo apt-get install -y sublime-text sublime-merge

echo "Installed Sublime Text 4 and Sublime Merge"

if [ ! -f "${installed_packages_dir}/Package Control.sublime-package" ]; then
    package_file="$(mktemp "${installed_packages_dir}/.package-control.XXXXXX")"
    curl -fsSL "https://packagecontrol.io/Package%20Control.sublime-package" \
        -o "$package_file"
    mv "$package_file" "${installed_packages_dir}/Package Control.sublime-package"
fi
echo "Package Control downloaded — run Sublime Text to finish plugin setup"

echo "Note: Remember to enter licenses if you have one"

{{ else -}}

echo "Linux flavour $OSTYPE not supported for Sublime installation."

{{ end -}}
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

{{ includeTemplate "homebrew-env.sh" . }}
# Homebrew casks own the subl/smerge links under the active Homebrew prefix.
for app in sublime-text sublime-merge; do
    if ! brew list --cask "$app" >/dev/null 2>&1; then
        brew install --cask "$app"
    fi
done

echo "Installed Sublime Text 4"
echo "Installed Sublime Merge"
echo "Note: Remember to enter licenses if you have one"

{{ end -}}
{{ end -}}
