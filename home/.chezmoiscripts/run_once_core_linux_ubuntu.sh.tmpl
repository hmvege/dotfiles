{{ if (eq .chezmoi.os "linux") -}}
{{ if (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/bin/bash

# Set to catch non-zero exit status errors, variable errors or pipeline
# failures.
set -euo pipefail

{{ if eq .chezmoi.osRelease.versionID "20.04" -}}
echo "Unsupported Ubuntu release: 20.04. Supported releases are 22.04, 24.04, and 26.04." >&2
exit 1
{{ end -}}

{{ if .lite -}}
{{ includeTemplate "install-lite-linux.sh" . }}
{{ else -}}

export PATH="$HOME/.local/bin:$PATH"
sudo apt-get update

packages=(
    # Various CLI tools
    bat
    fd-find
    git
    htop
    jq
    tmux
    vim
    rename
    silversearcher-ag
    unzip
    wget
    zsh

)

# General development tools remain in full mode; uv supplies prebuilt Python.
packages+=(build-essential)

{{ if .gui }}
# Gogh is available in full GUI mode, including WSL with a Linux desktop terminal.
packages_gogh_requirements=(
    dconf-cli
    uuid-runtime
)

packages+=( "${packages_gogh_requirements[@]}" )
{{ end }}

sudo apt-get install -y "${packages[@]}"
echo "Packages installed."

{{ includeTemplate "link-ubuntu-command.sh" . }}
link_ubuntu_command batcat bat
link_ubuntu_command fdfind fd

## Oh-my-zsh
if [ -d "${HOME}/.oh-my-zsh" ]; then
    echo "Oh My Zsh already installed at: ${HOME}/.oh-my-zsh"
else
    # sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    echo "Oh My Zsh is installed."
fi

# Oh-my-zsh plugins. Respect a custom location, otherwise use the home directory.
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
if [ ! -d "$ZSH_CUSTOM"/plugins/zsh-syntax-highlighting ]
then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_CUSTOM"/plugins/zsh-syntax-highlighting
    echo "zsh-syntax-highlighting downloaded and installed"
else
    echo "zsh-syntax-highlighting already installed"
fi

if [ ! -d "$ZSH_CUSTOM"/plugins/zsh-autosuggestions ]
then
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM"/plugins/zsh-autosuggestions
    echo "zsh-autosuggestions downloaded and installed"
else
    echo "zsh-autosuggestions already installed"
fi

## tmux plugins
if [ ! -d "${HOME}/.tmux/plugins/tpm" ]
then
    git clone https://github.com/tmux-plugins/tpm.git "${HOME}/.tmux/plugins/tpm"
    echo "tmux plugin manager installed."
else
    echo "tmux plugin manager already installed."
fi

## vim plugin manager
if [ ! -d "${HOME}/.vim/autoload/plug.vim" ]
then
    curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    echo "vim plugin manager installed"
else
    echo "vim plugin manager already installed"
fi

{{ includeTemplate "install-zoxide.sh" . }}

# Install the official standalone Codex CLI without modifying managed profiles.
export PATH="$HOME/.local/bin:$PATH"
if ! command -v codex >/dev/null 2>&1; then
    if [ -e "$HOME/.local/bin/codex" ] || [ -L "$HOME/.local/bin/codex" ]; then
        echo "Cannot install Codex: conflicting $HOME/.local/bin/codex. Move it explicitly and retry." >&2
        exit 1
    fi
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://chatgpt.com/codex/install.sh -o "$installer"
    CODEX_NON_INTERACTIVE=1 CODEX_INSTALL_DIR="$HOME/.local/bin" \
        sh "$installer" --release latest
fi
codex --version

## Install fzf, reusing an existing checkout after an interrupted installation.
if ! command -v fzf >/dev/null 2>&1; then
    if [ ! -e "$HOME/.fzf" ] && [ ! -L "$HOME/.fzf" ]; then
        git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
    fi
    if [ -f "$HOME/.fzf/install" ]; then
        bash "$HOME/.fzf/install" --key-bindings --completion --no-update-rc --no-fish
        export PATH="$HOME/.fzf/bin:$PATH"
        echo "Installed fzf"
    else
        echo "Cannot install fzf: existing $HOME/.fzf has no install script." >&2
        exit 1
    fi
else
    echo "Already installed fzf"
fi

## Python environment management
{{ includeTemplate "install-uv.sh" . }}
{{ includeTemplate "python-tools.sh" . }}

# ## Brew # NOTE: unused since built in tools cover most of what is needed
# if ! type -p brew >/dev/null 2>&1
# then
#     /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
#     echo "Installed Brew"
# fi

{{ if .gui }}
# We only install VSCode if snap is available on the system
if command -v snap &> /dev/null; then
    if ! type -p code >/dev/null 2>&1
    then
        sudo snap install --classic code
        echo "Installed VSCode"
    else
        echo "Already installed VSCode"
    fi

    vscode_extensions=(
        cschlosser.doxdocgen
        eamodio.gitlens
        ms-azuretools.vscode-docker
        charliermarsh.ruff
        ms-python.mypy-type-checker
        ms-python.python
        ms-python.vscode-pylance
        ms-toolsai.jupyter
        ms-toolsai.jupyter-keymap
        ms-toolsai.jupyter-renderers
        ms-toolsai.vscode-jupyter-cell-tags
        ms-toolsai.vscode-jupyter-slideshow
        ms-vscode-remote.remote-containers
        ms-vscode.cmake-tools
        ms-vscode.cpptools
        ms-vscode.cpptools-extension-pack
        ms-vscode.cpptools-themes
        sashaweiss.block-travel
        streetsidesoftware.code-spell-checker
        twxs.cmake
        xaver.clang-format
        yzhang.markdown-all-in-one
    )

    installed_extensions="$(code --list-extensions)"
    for extension in "${vscode_extensions[@]}"; do
        if ! grep -Fqix -- "$extension" <<< "$installed_extensions"; then
            if code --install-extension "$extension"; then
                echo "Installed $extension"
            else
                echo "VS Code reported an error while installing $extension; checking the final state." >&2
            fi
        else
            echo "VSCode extension $extension found"
        fi
    done
    installed_extensions="$(code --list-extensions)"
    for extension in "${vscode_extensions[@]}"; do
        if ! grep -Fqix -- "$extension" <<< "$installed_extensions"; then
            echo "VS Code extension missing after installation: $extension" >&2
            exit 1
        fi
    done

else
    echo "Snap is not available. Skipping VSCode installation."
fi
{{ end -}}

{{ includeTemplate "install-lsd.sh" . }}

{{ if .gui }}
## Gogh configures GNOME Terminal, including a GNOME Terminal running under WSLg.
if ! command -v gnome-terminal >/dev/null 2>&1 || \
   [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || \
   { [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; }; then
    echo "Skipping Gogh: GNOME Terminal and a graphical D-Bus session are required. Windows Terminal is configured separately."
else
    GOGH_DIRECTORY="$HOME/src/gogh"
    if [ ! -d "$GOGH_DIRECTORY" ]; then
        mkdir -p "$HOME/src"
        git clone https://github.com/Gogh-Co/Gogh.git "$GOGH_DIRECTORY"
    fi
    # A failed theme application can be retried using the existing checkout.
    if ! env TERMINAL=gnome-terminal GOGH_NONINTERACTIVE=1 \
        bash "$GOGH_DIRECTORY/installs/afterglow.sh"; then
        echo "WARNING: Gogh could not configure GNOME Terminal. Retry from its desktop session." >&2
    fi
fi
{{ end -}}
{{ end -}}
{{ end -}}
{{ end -}}
