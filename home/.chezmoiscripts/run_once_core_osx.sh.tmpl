{{ if (eq .chezmoi.os "darwin") -}}
#!/bin/bash

# Set to catch non-zero exit status errors, variable errors or pipeline
# failures.
set -euo pipefail

{{ if .lite -}}
{{ includeTemplate "homebrew-env.sh" . }}
# Lite uses an existing Homebrew to avoid bootstrapping developer tools.
if command -v brew >/dev/null 2>&1 && [ "$EUID" -ne 0 ]; then
    # Avoid updates and retain existing tools, including macOS Git, Vim and Zsh.
    for pkg in git zsh vim fzf the_silver_searcher uv zoxide; do
        tool="$pkg"
        [ "$pkg" != the_silver_searcher ] || tool=ag
        if ! command -v "$tool" >/dev/null 2>&1; then
            if ! HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_UPGRADE=1 brew install --formula "$pkg"; then
                echo "Warning: could not install $pkg. Continuing lite setup." >&2
            fi
        fi
    done
else
    echo "Skipping optional packages: lite requires an existing Homebrew and a non-root user."
fi

{{ includeTemplate "install-uv.sh" . }}
echo "Lite setup attempted. Start zsh to load the configuration."
{{ else -}}

packages=(
    bat
    fd
    fzf
    git
    htop
    jq
    lsd
    node  # Needed by LSP
    uv
    the_silver_searcher
    tmux
    unzip
    # vim # Should already be installed on Mac
    wget
    zoxide
    zsh
)

## Brew (the installer also handles missing Command Line Tools)
{{ includeTemplate "homebrew-env.sh" . }}
if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    {{ includeTemplate "homebrew-env.sh" . }}
fi
command -v brew >/dev/null 2>&1 || { echo "Homebrew is unavailable" >&2; exit 1; }

brew update
# Leave upgrades to the user. Dependencies of new packages may still be updated.
for pkg in "${packages[@]}"; do
    if ! brew list --formula "$pkg" >/dev/null 2>&1; then
        brew install --formula "$pkg"
    fi
done
echo "Packages installed"

## OMZ 
if [ ! -d "${HOME}/.oh-my-zsh" ]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    echo "Oh My Zsh is installed."
fi

# oh-my-zsh plugins
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git \
      "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
fi

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions.git \
      "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
fi

{{ includeTemplate "python-tools.sh" . }}

## fzf installation completion
"$(brew --prefix fzf)/install" --key-bindings --completion --no-update-rc --no-fish

## vim plugin manager
if [ ! -d "${HOME}/.vim/autoload/plug.vim" ]
then
    curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    echo "vim plugin manager installed"
else
    echo "vim plugin manager already installed"
fi

{{ if .gui }}
## VSCode installation
if ! command -v code >/dev/null 2>&1
then
    if ! brew list --cask visual-studio-code >/dev/null 2>&1; then
        brew install --cask visual-studio-code
    fi
    echo "VSCode installed."
else
    echo "VSCode already installed"
fi

vscode_extensions=(
    cschlosser.doxdocgen
    eamodio.gitlens
    ms-azuretools.vscode-docker
    charliermarsh.ruff
    ms-python.mypy-type-checker
    ms-python.python
    ms-python.vscode-pylance
    ms-toolsai.jupyter
    ms-toolsai.jupyter-keymap
    ms-toolsai.jupyter-renderers
    ms-toolsai.vscode-jupyter-cell-tags
    ms-toolsai.vscode-jupyter-slideshow
    ms-vscode-remote.remote-containers
    ms-vscode.cmake-tools
    ms-vscode.cpptools
    ms-vscode.cpptools-extension-pack
    ms-vscode.cpptools-themes
    sashaweiss.block-travel
    streetsidesoftware.code-spell-checker
    twxs.cmake
    xaver.clang-format
    yzhang.markdown-all-in-one
)

installed_extensions=$(code --list-extensions)
for extension in "${vscode_extensions[@]}"
do
    if ! grep -Fqx -- "$extension" <<< "$installed_extensions"
    then
        code --install-extension "$extension"
        echo "Installed $extension"
    else
        echo "VSCode extension $extension found"
    fi
done
{{ end -}}
{{ end -}}
{{ end -}}
