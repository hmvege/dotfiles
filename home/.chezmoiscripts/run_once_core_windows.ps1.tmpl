{{ if eq .chezmoi.os "windows" -}}
{{ includeTemplate "windows-pwsh-bootstrap.ps1" . }}

Write-Output "--- Running Windows core setup script ---"

function Invoke-SetupCommand {
    param([string]$Command, [string[]]$Arguments)

    $global:LASTEXITCODE = 0
    & $Command @Arguments
    if ($LASTEXITCODE -ne 0) {
        throw "$Command $($Arguments -join ' ') failed with exit code $LASTEXITCODE."
    }
}

$scoopRoot = $env:SCOOP
if (-not $scoopRoot) { $scoopRoot = Join-Path $env:USERPROFILE 'scoop' }
$scoopShims = Join-Path $scoopRoot 'shims'
if (Test-Path -LiteralPath $scoopShims) { $env:PATH = "$scoopShims;$env:PATH" }

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Output 'Installing Scoop for the current user...'
    Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    $global:LASTEXITCODE = 0
    Invoke-RestMethod 'https://get.scoop.sh' | Invoke-Expression
    if ($LASTEXITCODE -ne 0) { throw "Scoop bootstrap failed with exit code $LASTEXITCODE." }
    Update-SetupPath
    $env:PATH = "$scoopShims;$env:PATH"
    if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
        throw 'Scoop bootstrap completed but scoop is unavailable.'
    }
}

function Ensure-ScoopPackage {
    param([string]$Name)

    # Scope detection to this user's Scoop root, including custom SCOOP paths.
    $metadata = Join-Path $scoopRoot "apps\$Name\current\install.json"
    if (Test-Path -LiteralPath $metadata -PathType Leaf) {
        Write-Output "$Name is already installed."
    }
    else {
        Invoke-SetupCommand scoop @('install', $Name)
        if (-not (Test-Path -LiteralPath $metadata -PathType Leaf)) {
            throw "Scoop did not finish installing $Name."
        }
    }
}

function Ensure-ScoopBucket {
    param([string]$Name)

    if (-not (Test-Path -LiteralPath (Join-Path $scoopRoot "buckets\$Name") -PathType Container)) {
        Invoke-SetupCommand scoop @('bucket', 'add', $Name)
    }
}

# Git is needed before Scoop can add or update buckets.
Ensure-ScoopPackage 'git'
Invoke-SetupCommand scoop @('update')

$packages = @(
    'ag',
    'bat',
    'cloc',
    'coreutils',
    'cppcheck',
    'curl',
    'fd',
    'fzf',
    'jq',
    'lsd',
    'marp',
    'oh-my-posh',
    'python',
    'ripgrep',
    'vim',
    'zoxide'
)
foreach ($pkg in $packages) { Ensure-ScoopPackage $pkg }

# Migrate the previous Scoop-owned module to the PSGallery post-install step.
if (Test-Path -LiteralPath (Join-Path $scoopRoot 'apps\psfzf\current\install.json')) {
    Invoke-SetupCommand scoop @('uninstall', 'psfzf')
}

# Use Scoop's Python explicitly to avoid the Windows Store execution alias.
$python = Join-Path $scoopRoot 'apps\python\current\python.exe'
$global:LASTEXITCODE = 0
& $python -m pip show pipx *> $null
if ($LASTEXITCODE -ne 0) {
    Invoke-SetupCommand $python @('-m', 'pip', 'install', '--user', 'pipx')
}
Invoke-SetupCommand $python @('-m', 'pipx', 'ensurepath')
Update-SetupPath
$pipxBin = Invoke-SetupCommand $python @('-m', 'pipx', 'environment', '--value', 'PIPX_BIN_DIR')
$env:PATH = "$pipxBin;$env:PATH"

$pipxPkgs = @('black', 'flake8', 'mypy', 'pre-commit', 'poetry', 'pip-tools', 'mkdocs')
$pipxState = (Invoke-SetupCommand $python @('-m', 'pipx', 'list', '--json')) | ConvertFrom-Json
$installedPipx = @($pipxState.venvs.PSObject.Properties.Name)
foreach ($pkg in $pipxPkgs) {
    if ($pkg -notin $installedPipx) {
        Invoke-SetupCommand $python @('-m', 'pipx', 'install', $pkg)
    }
    else {
        Write-Output "$pkg is already installed with pipx."
    }
}

{{ if and .gui (not .lite) -}}
Ensure-ScoopBucket 'extras'
Ensure-ScoopBucket 'nerd-fonts'
foreach ($pkg in @('windirstat', 'sublime-merge', 'Meslo-NF', 'JetBrainsMono-NF', 'vscode')) {
    Ensure-ScoopPackage $pkg
}

# Add VSCode only to this process; Scoop owns its persistent environment setup.
$codePath = Join-Path $scoopRoot 'apps\vscode\current\bin'
$env:PATH = "$codePath;$env:PATH"
$code = Join-Path $codePath 'code.cmd'

$vscodeExtensions = @(
    "cschlosser.doxdocgen",
    "eamodio.gitlens",
    "esbenp.prettier-vscode",
    "ms-azuretools.vscode-docker",
    "ms-python.python",
    "ms-toolsai.jupyter",
    "ms-vscode-remote.remote-containers",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpptools-extension-pack",
    "ms-vscode.cpptools-themes",
    "ms-vscode.cpptools",
    "sashaweiss.block-travel",
    "streetsidesoftware.code-spell-checker",
    "twxs.cmake",
    "xaver.clang-format",
    "yzhang.markdown-all-in-one"
)

$installedExtensions = @(Invoke-SetupCommand $code @('--list-extensions'))
foreach ($ext in $vscodeExtensions) {
    if ($ext -notin $installedExtensions) {
        Invoke-SetupCommand $code @('--install-extension', $ext)
    }
    else {
        Write-Output "VSCode extension $ext is already installed."
    }
}
{{ end -}}

Write-Output '==== Windows core tools setup complete ===='
Write-Output 'Open a new PowerShell 7 terminal to load the profile and updated PATH.'
{{ end -}}
