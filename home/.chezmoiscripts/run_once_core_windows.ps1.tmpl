# Migrate the previous Scoop-owned module to the PSGallery post-install step.
if (Test-Path -LiteralPath (Join-Path $scoopRoot 'apps\psfzf\current\install.json')) {
    Invoke-SetupCommand scoop @('uninstall', 'psfzf')
}

# Scoop owns uv; no separate Scoop Python is needed for new installations.
$uv = Join-Path $scoopRoot 'shims\uv.exe'
Invoke-SetupCommand $uv @('python', 'install', '3.12')
$python = Invoke-SetupCommand $uv @('python', 'find', '--managed-python', '3.12')

# uv owns Python CLI tools. Existing non-uv commands are
# preserved and reported so their environments can be migrated explicitly.
$uvToolBin = Invoke-SetupCommand $uv @('tool', 'dir', '--bin')
# Persist only the additional user tool directory, never the merged process PATH.
$userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
if ($uvToolBin -notin ($userPath -split ';')) {
    $userPaths = @($userPath, $uvToolBin) | Where-Object { $_ }
    [Environment]::SetEnvironmentVariable('Path', ($userPaths -join ';'), 'User')
}
$env:PATH = "$uvToolBin;$env:PATH"
$uvToolNames = @(
    Invoke-SetupCommand $uv @('tool', 'list') | ForEach-Object {
        if ($_ -match '^(\S+) v') { $Matches[1] }
    }
)

function Install-UvTool {
    param(
        [string]$Package,
        [string]$Command,
        [string[]]$With = @()
    )

    if ($Package -in $uvToolNames) {
        Write-Output "$Package is already installed with uv; preserving its environment."
        return
    }

    $existing = Get-Command $Command -CommandType Application,ExternalScript -ErrorAction SilentlyContinue |
        Select-Object -First 1
    if ($existing) {
        Write-Warning "Skipping uv tool install $Package because $Command is already provided by $($existing.Source)."
        Write-Warning 'Record and remove the existing tool explicitly before migrating it to uv. See README.md.'
        return
    }

    $arguments = @('tool', 'install', '--python', $python)
    foreach ($dependency in $With) { $arguments += @('--with', $dependency) }
    $arguments += $Package
    Invoke-SetupCommand $uv $arguments
}

